{
  "info": {
    "_postman_id": "c1f7b8e2-9b24-4f1a-8c63-4b9d5c8e2211",
    "name": "SunPower ERP — Phase 1 & 2 (Foundation & Auth/RBAC)",
    "description": "Complete test collection for SunPower ERP APIs including automated token capture, token clearing on logout, refresh token rotation, and RBAC endpoint verification.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "admin@sunpower.com",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "SunPower@Admin2026",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "createdUserId",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "0. System Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Verifies the Express server is up and responsive."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Authentication",
      "item": [
        {
          "name": "Login (Captures Token Automatically)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status code is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", res.data.accessToken);",
                  "    console.log(\"[Auth Script]: Successfully captured and stored accessToken.\");",
                  "}",
                  "if (res.data && res.data.refreshToken) {",
                  "    pm.collectionVariables.set(\"refreshToken\", res.data.refreshToken);",
                  "    console.log(\"[Auth Script]: Successfully captured and stored refreshToken.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates user and auto-saves accessToken and refreshToken to Collection Variables."
          },
          "response": []
        },
        {
          "name": "Get Current Profile (Me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Retrieves the currently authenticated user with active roles and permissions."
          },
          "response": []
        },
        {
          "name": "Refresh Access Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "pm.test(\"Status code is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "if (res.data && res.data.accessToken) {",
                  "    pm.collectionVariables.set(\"accessToken\", res.data.accessToken);",
                  "    console.log(\"[Auth Script]: Access token refreshed.\");",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Rotates refresh token and gets a new access token."
          },
          "response": []
        },
        {
          "name": "Logout (Revokes on Server & Clears Postman Tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", \"\");",
                  "pm.collectionVariables.set(\"refreshToken\", \"\");",
                  "console.log(\"[Auth Script]: Successfully cleared accessToken and refreshToken from Postman collection variables on logout.\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Sends active Bearer access token and refresh token to server to add to blacklist/revoke, then resets Postman's accessToken variable to empty."
          },
          "response": []
        },
        {
          "name": "Forgot Password",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/forgot-password",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "forgot-password"]
            },
            "description": "Sends password reset instructions. Always returns generic message to prevent account enumeration."
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. User Management (RBAC Protected)",
      "item": [
        {
          "name": "List Users (Requires users:read)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Fetches paginated list of users. Protected by RBAC permission: users:read."
          },
          "response": []
        },
        {
          "name": "Create User (Requires users:manage)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.data && res.data.id) {",
                  "    pm.collectionVariables.set(\"createdUserId\", res.data.id);",
                  "    console.log(\"[User Script]: Stored createdUserId:\", res.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"engineer@sunpower.com\",\n  \"phone_e164\": \"+919876543210\",\n  \"password\": \"EngineerPass2026!\",\n  \"full_name\": \"Field Survey Engineer\",\n  \"role_codes\": [\"SURVEY_ENGINEER\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Creates a new user and assigns roles in a transaction. Auto-stores createdUserId in collection variables."
          },
          "response": []
        },
        {
          "name": "Get User By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{createdUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{createdUserId}}"]
            },
            "description": "Fetches a specific user profile by UUID."
          },
          "response": []
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Lead Rooftop Survey Engineer\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{createdUserId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users", "{{createdUserId}}"]
            },
            "description": "Updates user profile attributes."
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. Security & Negative Failure Tests",
      "item": [
        {
          "name": "401 Unauthenticated (No Token)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"]
            },
            "description": "Verifies that accessing protected endpoints without a token returns 401 UNAUTHENTICATED."
          },
          "response": []
        },
        {
          "name": "400 Validation Error (Malformed Login)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalid-email-address\",\n  \"password\": \"short\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Verifies that invalid input triggers Zod schema validation errors with code VALIDATION_ERROR."
          },
          "response": []
        },
        {
          "name": "404 Route Not Found",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/non-existent-route",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "non-existent-route"]
            },
            "description": "Verifies that unknown routes return standardized NOT_FOUND error envelope."
          },
          "response": []
        }
      ]
    }
  ]
}
