    {
      "name": "1. Authentication & Token Lifecycle",
      "item": [
        {
          "name": "Login (Auto-Captures Tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    const access = jsonData.data.accessToken || (jsonData.data.tokens && jsonData.data.tokens.accessToken);",
                  "    const refresh = jsonData.data.refreshToken || (jsonData.data.tokens && jsonData.data.tokens.refreshToken);",
                  "    if (access) {",
                  "        pm.collectionVariables.set('accessToken', access);",
                  "        pm.environment.set('accessToken', access);",
                  "        pm.globals.set('accessToken', access);",
                  "        console.log('[Postman] Access token successfully saved to Collection, Environment, and Globals.');",
                  "    }",
                  "    if (refresh) {",
                  "        pm.collectionVariables.set('refreshToken', refresh);",
                  "        pm.environment.set('refreshToken', refresh);",
                  "        pm.globals.set('refreshToken', refresh);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Logs in the initial administrator and automatically populates {{accessToken}} and {{refreshToken}} in the collection."
          },
          "response": []
        },
        {
          "name": "Get Authenticated Profile (/auth/me)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "me"]
            },
            "description": "Fetches the current user claims, active roles, and granted permissions using the Bearer access token."
          },
          "response": []
        },
        {
          "name": "Rotate Refresh Token (/auth/refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "if (jsonData && jsonData.data) {",
                  "    const access = jsonData.data.accessToken || (jsonData.data.tokens && jsonData.data.tokens.accessToken);",
                  "    const refresh = jsonData.data.refreshToken || (jsonData.data.tokens && jsonData.data.tokens.refreshToken);",
                  "    if (access) {",
                  "        pm.collectionVariables.set('accessToken', access);",
                  "        pm.environment.set('accessToken', access);",
                  "        pm.globals.set('accessToken', access);",
                  "        console.log('[Postman] Rotated access token saved to Collection, Environment, and Globals.');",
                  "    }",
                  "    if (refresh) {",
                  "        pm.collectionVariables.set('refreshToken', refresh);",
                  "        pm.environment.set('refreshToken', refresh);",
                  "        pm.globals.set('refreshToken', refresh);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "refresh"]
            },
            "description": "Rotates refresh token. Implements cryptographic family hash detection for replay protection."
          },
          "response": []
        },
        {
          "name": "Logout (/auth/logout)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.collectionVariables.set('accessToken', '');",
                  "pm.collectionVariables.set('refreshToken', '');",
                  "pm.environment.set('accessToken', '');",
                  "pm.environment.set('refreshToken', '');",
                  "pm.globals.set('accessToken', '');",
                  "pm.globals.set('refreshToken', '');",
                  "console.log('[Postman] Logged out. Collection, Environment, and Global tokens cleared.');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            },
            "description": "Revokes the session refresh token and puts the active access token on the server denylist."
          },
          "response": []
        }
      ]
    },
