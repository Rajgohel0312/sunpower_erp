  start_date                  DateTime           @default(now()) @db.Timestamptz(6)
  end_date                    DateTime           @db.Timestamptz(6)
  status                      String             @default("ACTIVE") @db.VarChar(50)
  qr_code_hash                String?            @db.VarChar(100)
  created_at                  DateTime           @default(now()) @db.Timestamptz(6)
  updated_at                  DateTime           @default(now()) @db.Timestamptz(6)
  service_tickets             service_tickets[]
  customers                   customers          @relation(fields: [customer_id], references: [id], onUpdate: NoAction)
  installation_jobs           installation_jobs? @relation(fields: [installation_job_id], references: [id], onUpdate: NoAction)
  products                    products?          @relation(fields: [product_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  sales_orders                sales_orders       @relation(fields: [sales_order_id], references: [id], onUpdate: NoAction)
  serial_numbers              serial_numbers?    @relation(fields: [serial_number_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([warranty_certificate_number], map: "idx_warranties_cert_num")
  @@index([customer_id], map: "idx_warranties_customer")
  @@index([sales_order_id], map: "idx_warranties_order")
  @@index([serial_number_id], map: "idx_warranties_serial")
  @@index([status], map: "idx_warranties_status")
}

model warranty_replacements {
  id                                                                         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id                                                                  String          @db.Uuid
  defective_serial_id                                                        String          @db.Uuid
  replacement_serial_id                                                      String          @db.Uuid
  replaced_by                                                                String?         @db.Uuid
  replaced_at                                                                DateTime        @default(now()) @db.Timestamptz(6)
  transfer_warranty                                                          Boolean         @default(true)
  reason                                                                     String
  notes                                                                      String?
  created_at                                                                 DateTime        @default(now()) @db.Timestamptz(6)
  serial_numbers_warranty_replacements_defective_serial_idToserial_numbers   serial_numbers  @relation("warranty_replacements_defective_serial_idToserial_numbers", fields: [defective_serial_id], references: [id], onUpdate: NoAction)
  users                                                                      users?          @relation(fields: [replaced_by], references: [id], onUpdate: NoAction)
  serial_numbers_warranty_replacements_replacement_serial_idToserial_numbers serial_numbers  @relation("warranty_replacements_replacement_serial_idToserial_numbers", fields: [replacement_serial_id], references: [id], onUpdate: NoAction)
  service_tickets                                                            service_tickets @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([defective_serial_id], map: "idx_warranty_replacements_defective")
  @@index([replacement_serial_id], map: "idx_warranty_replacements_replacement")
  @@index([ticket_id], map: "idx_warranty_replacements_ticket")
}
