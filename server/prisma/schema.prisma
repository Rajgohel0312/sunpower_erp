  project_boms_project_boms_created_byTousers  project_boms[]       @relation("project_boms_created_byTousers")
  refresh_tokens                               refresh_tokens[]
  surveys_surveys_assigned_engineer_idTousers  surveys[]            @relation("surveys_assigned_engineer_idTousers")
  surveys_surveys_created_byTousers            surveys[]            @relation("surveys_created_byTousers")
  surveys_surveys_reviewed_byTousers           surveys[]            @relation("surveys_reviewed_byTousers")
  user_roles                                   user_roles[]

  @@index([email], map: "idx_users_email")
  @@index([phone_e164], map: "idx_users_phone")
}

model product_categories {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String     @unique @db.VarChar(50)
  name        String     @db.VarChar(100)
  description String?
  is_active   Boolean    @default(true)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)
  updated_at  DateTime   @default(now()) @db.Timestamptz(6)
  products    products[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id                     String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id            String                  @db.Uuid
  sku                    String                  @unique @db.VarChar(100)
  brand                  String                  @db.VarChar(100)
  model_name             String                  @db.VarChar(150)
  rated_capacity_w       Decimal?                @db.Decimal(10, 2)
  unit_code              String                  @default("NOS") @db.VarChar(20)
  standard_cost          Decimal                 @default(0.00) @db.Decimal(14, 2)
  tax_rate_pct           Decimal                 @default(12.00) @db.Decimal(5, 2)
  hsn_code               String?                 @default("85414011") @db.VarChar(20)
