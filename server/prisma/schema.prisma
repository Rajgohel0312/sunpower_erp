  @@index([assigned_to], map: "idx_leads_assigned_to")
  @@index([created_at(sort: Desc)], map: "idx_leads_created_at")
  @@index([customer_id], map: "idx_leads_customer_id")
  @@index([phone_e164], map: "idx_leads_phone")
  @@index([stage], map: "idx_leads_stage")
  @@index([stage, created_at(sort: Desc)], map: "idx_leads_stage_created")
  @@index([full_name(ops: raw("gin_trgm_ops"))], map: "idx_leads_full_name_trgm", type: Gin)
  @@index([lead_number(ops: raw("gin_trgm_ops"))], map: "idx_leads_lead_number_trgm", type: Gin)
  @@index([phone_e164(ops: raw("gin_trgm_ops"))], map: "idx_leads_phone_trgm", type: Gin)
  @@index([site_address(ops: raw("gin_trgm_ops"))], map: "idx_leads_site_address_trgm", type: Gin)
}

model login_events {
