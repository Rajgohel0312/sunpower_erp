# SunPower ERP — Server Environment Variables (Example Template)
# Copy this file to .env and configure your local settings. NEVER commit .env to version control!

# App Configuration
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000/api/v1

# PostgreSQL Database
DATABASE_URL=postgresql://app_user:postgres@localhost:5432/sunpower_erp
DB_POOL_MAX=20

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_a_long_random_jwt_access_secret_in_development
JWT_REFRESH_SECRET=replace_with_a_different_long_random_jwt_refresh_secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# File Storage
STORAGE_ROOT=./storage
MAX_UPLOAD_BYTES=10485760

# WhatsApp / Baileys Gateway Process
WHATSAPP_GATEWAY_INTERNAL_URL=http://localhost:5100
WHATSAPP_INTERNAL_TOKEN=replace_with_internal_service_secret
BAILEYS_AUTH_DIR=./storage/whatsapp/auth
