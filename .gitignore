# SunPower ERP — .gitignore
# Enforces Rule 12: Never commit .env, storage/, node_modules/, or WhatsApp session files

# Dependencies
node_modules/
/.pnp
.pnp.js

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example

# Local File Storage & Uploads
storage/
server/storage/
client/storage/
uploads/

# WhatsApp / Baileys Session & Auth Storage
*whatsapp*auth*
baileys_auth_info/
*.session
*.session-data

# Build Outputs & Generated Assets
dist/
dist-ssr/
build/
*.tsbuildinfo

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing & Coverage
coverage/
.nyc_output/

# OS & Editor Artifacts
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
